{
  "name": "deskmony",
  "version": "0.1.0",
  "private": true,
  "description": "Deskmony - Agent Team 管理平台 (M1 單 agent MVP)",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm typecheck && pnpm build && node scripts/run-e2e.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:live": "node scripts/e2e-gateway.mjs",
    "cli": "node apps/cli/dist/bin.js",
    "dev:core": "pnpm --filter @deskmony/core run dev",
    "dev:desktop": "pnpm --filter @deskmony/desktop run dev",
    "dev:electron": "pnpm --filter @deskmony/desktop run electron",
    "start:core": "pnpm --filter @deskmony/core run start",
    "package": "pnpm --filter @deskmony/desktop run package",
    "package:dir": "pnpm --filter @deskmony/desktop run package:dir",
    "clean": "pnpm -r run clean",
    "generate:config-schema": "node scripts/generate-config-schema.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@agentclientprotocol/sdk": "^1.2.1",
    "@electron/rebuild": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ],
    "overrides": {
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "fast-uri": "^3.1.9",
      "ip-address": "^10.7.1",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.18",
      "tar": "^7.5.21",
      "browserslist": "^4.28.7",
      "prismjs": "^1.30.0",
      "postcss": "^8.5.23",
      "undici": "^6.29.1",
      "hono": "^4.13.7",
      "@hono/node-server": "^1.19.15",
      "qs": "^6.16.0",
      "@xmldom/xmldom": "^0.8.15",
      "proxy-addr": "^2.0.8",
      "source-map-js": "^1.2.2",
      "body-parser@2": "^2.4.0",
      "@openai/codex": "0.156.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-ch52-4w7c-c8xp"
      ]
    },
    "packageExtensions": {
      "react-i18next": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": { "optional": true }
        }
      }
    },
    "patchedDependencies": {
      "@agentclientprotocol/codex-acp@1.13.1": "patches/@agentclientprotocol__codex-acp@1.13.1.patch",
      "@openai/codex@0.156.1": "patches/@openai__codex@0.156.1.patch"
    }
  },
  "license": "MIT"
}
