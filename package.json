{
  "name": "deskmony",
  "version": "0.1.0",
  "private": true,
  "description": "Deskmony - Agent Team 管理平台 (M1 單 agent MVP)",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm typecheck && pnpm build && node scripts/run-e2e.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:live": "node scripts/e2e-gateway.mjs",
    "dev:core": "pnpm --filter @deskmony/core run dev",
    "dev:desktop": "pnpm --filter @deskmony/desktop run dev",
    "dev:electron": "pnpm --filter @deskmony/desktop run electron",
    "start:core": "pnpm --filter @deskmony/core run start",
    "package": "pnpm --filter @deskmony/desktop run package",
    "package:dir": "pnpm --filter @deskmony/desktop run package:dir",
    "clean": "pnpm -r run clean",
    "generate:config-schema": "node scripts/generate-config-schema.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@agentclientprotocol/sdk": "^1.2.1",
    "@electron/rebuild": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ],
    "overrides": {
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "fast-uri": "^3.1.6",
      "ip-address": "^10.3.1",
      "js-yaml@4": "^4.3.1",
      "nanoid@3": "^3.3.18",
      "tar": "^7.5.21",
      "browserslist": "^4.28.7",
      "prismjs": "^1.30.0",
      "postcss": "^8.5.23",
      "undici": "^6.28.0",
      "hono": "^4.12.34",
      "@hono/node-server": "^1.19.15",
      "qs": "^6.16.0",
      "@xmldom/xmldom": "^0.8.15"
    }
  },
  "license": "MIT"
}
