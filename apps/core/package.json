{
  "name": "@deskmony/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@deskmony/adapters": "workspace:*",
    "@deskmony/db": "workspace:*",
    "@deskmony/shared": "workspace:*",
    "better-sqlite3": "^11.6.0",
    "drizzle-orm": "^0.36.4",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13"
  }
}
